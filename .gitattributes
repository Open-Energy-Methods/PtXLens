# Scientific evidence data use exact file-byte SHA-256 provenance links.
# Preserve LF in working tree even on Windows with core.autocrlf=true.
# Otherwise hash-linked LP -> independently replayed integer evidence can
# break on a fresh checkout without any scientific input changing.
data/results/F3D_*.json text eol=lf
data/results/F3D_*.md text eol=lf

# Keep the source-linked pre-publication validation protocols as plain text.

# L3-E source rebuilt outputs are hash-validated as UTF-8 LF across Windows.
data/results/L3E_*.json text eol=lf
data/results/L3E_*.md text eol=lf

# L3-F source-locked scientific output SHA bytes must retain LF on Windows.
data/results/L3F_*.json text eol=lf
data/results/L3F_*.md text eol=lf
